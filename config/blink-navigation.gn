source_set("navigation") {
  sources = [
    "src/blink/navigation.cc",
    "src/blink/cookies.cc",
    "src/blink/web_storage.cc",
    "src/blink/blob_service.cc",
    "src/blink/cache_storage.cc",
    "src/blink/indexed_db.cc",
    "src/blink/media_player.cc",
    "src/blink/web_socket.cc",
    "src/blink/web_socket.h",
    "src/blink/web_storage.h",
    "src/blink/cookies.h",
    "//content/renderer/content_security_policy_util.cc",
    "//services/network/cors/preflight_result.cc",
    "//services/network/cors/cors_util.cc",
    "src/blink/navigation.h",
    "src/blink/resource_loader.cc",
    "src/blink/resource_loader.h",
    "src/blink/message_pump.cc",
    "src/blink/message_pump.h",
    "src/blink/pump_loop.h",
    "src/blink/scheduler.cc",
    "src/blink/scheduler.h",
    "src/blink/frame_loop.cc",
    "src/blink/scroll_scene.cc",
    "src/blink/scroll_scene.h",
    "src/blink/scroll_snapshot.h",
    "src/blink/frame_loop.h",
    "src/network/resource.c",
    "src/network/async.c",
    "src/network/resource.h",
    "src/network/chunks.c",
  ]
  if (use_uefi_runtime && current_toolchain == default_toolchain) {
    sources += [ "src/blink/workers.cc", "src/blink/browser_frame.cc", "src/blink/browser_frame.h", "src/blink/remote_frame.cc", "src/blink/remote_frame.h" ]
  }
  include_dirs = [ "src", "runtime" ]
  deps = [
    "//base",
    "//media",
    "//third_party/libvpx",
    "//third_party/libyuv",
    "//cc/paint",
    "//net",
    "//third_party/blink/renderer/core",
    "//ui/gfx/geometry",
    "//url",
  ]
}

if (use_uefi_runtime && current_toolchain == default_toolchain) {
  static_library("browser") {
    complete_static_lib = true
    sources = [
      "src/blink/browser_entry.cc",
      "src/blink/gpu_context.cc",
      "src/blink/webgl_context.cc",
      "//gpu/ipc/gl_in_process_context.cc",
      "//gpu/ipc/in_process_command_buffer.cc",
      "//gpu/ipc/gpu_in_process_thread_service.cc",
      "//gpu/ipc/in_process_gpu_thread_holder.cc",
      "src/blink/fonts.cc",
      "src/blink/discardable_memory.cc",
      "src/blink/input.cc",
      "//third_party/skia/src/ports/SkFontMgr_custom_embedded.cpp",
    ]
    include_dirs = [ "src", "runtime" ]
    deps = [
      ":navigation",
      "//base:i18n",
      "//third_party/brotli:dec",
      "//third_party/zlib/google:compression_utils",
      "//mojo/core/embedder",
      "//third_party/blink/renderer/controller",
      "//third_party/blink/renderer/core",
      "//v8:cppgc_headers",
      "//third_party/dawn/src/dawn/native",
      "//third_party/dawn/src/dawn/wire",
      "//third_party/swiftshader/src/Vulkan:swiftshader_libvulkan_static",
      "//gpu/command_buffer/service",
      "//gpu/command_buffer/service:gles2",
      "//gpu/command_buffer/client:gles2_implementation",
      "//gpu/ipc/service",
      "//gpu/ipc/client",
      "//gpu/ipc/host",
      "//ui/gl/init",
      "//ui/ozone",
    ]
  }
}
