+#ifdef VN_USE_UEFI
+extern VkResult firmware_venus_import_bo(struct vn_renderer *, uint32_t, uint64_t, struct vn_renderer_bo **);
+VkResult firmware_venus_import_memory(VkDevice, const VkMemoryAllocateInfo *, uint32_t, VkDeviceMemory *);
+VkResult firmware_venus_import_memory(VkDevice device, const VkMemoryAllocateInfo *info,
+                                     uint32_t resource, VkDeviceMemory *output)
+{
+   struct vn_device *dev=vn_device_from_handle(device);
+   struct vn_device_memory *mem=vk_device_memory_create(&dev->base.vk,info,NULL,sizeof(*mem));
+   if (!mem) return VK_ERROR_OUT_OF_HOST_MEMORY;
+   vn_object_set_id(mem,vn_get_next_obj_id(),VK_OBJECT_TYPE_DEVICE_MEMORY);
+   VkResult result=firmware_venus_import_bo(dev->renderer,resource,info->allocationSize,&mem->base_bo);
+   if (result!=VK_SUCCESS) {
+      vk_device_memory_destroy(&dev->base.vk,NULL,&mem->base.vk);
+      return result;
+   }
+   vn_ring_roundtrip(dev->primary_ring);
+   VkImportMemoryResourceInfoMESA import_info={
+      .sType=VK_STRUCTURE_TYPE_IMPORT_MEMORY_RESOURCE_INFO_MESA,
+      .pNext=info->pNext,.resourceId=resource,
+   };
+   VkMemoryAllocateInfo allocation=*info;
+   allocation.pNext=&import_info;
+   VkDeviceMemory handle=vn_device_memory_to_handle(mem);
+   result=vn_call_vkAllocateMemory(dev->primary_ring,device,&allocation,NULL,&handle);
+   if (result!=VK_SUCCESS) {
+      vn_renderer_bo_unref(dev->renderer,mem->base_bo);
+      vk_device_memory_destroy(&dev->base.vk,NULL,&mem->base.vk);
+      return result;
+   }
+   *output=handle;
+   return VK_SUCCESS;
+}
+#endif
