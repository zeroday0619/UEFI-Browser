diff --git a/src/common/code-memory-access.h b/src/common/code-memory-access.h
--- a/src/common/code-memory-access.h
+++ b/src/common/code-memory-access.h
@@ -636,7 +636,11 @@
       const RwxMemoryWriteScopeForTesting&) = delete;
 };
 
-#if V8_HEAP_USE_PTHREAD_JIT_WRITE_PROTECT
+#if defined(UEFI_RUNTIME)
+// UEFI metadata uses ordinary data pages. Its code write scope changes every
+// executable alias, so metadata-only access must not enter that scope.
+using CFIMetadataWriteScope = NopRwxMemoryWriteScope;
+#elif V8_HEAP_USE_PTHREAD_JIT_WRITE_PROTECT
 // Metadata are not protected yet with PTHREAD_JIT_WRITE_PROTECT
 using CFIMetadataWriteScope = NopRwxMemoryWriteScope;
 #else

