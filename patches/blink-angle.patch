+extern "C" bool firmware_angle_prepare_context(gl::Context*);
+extern "C" uint64_t firmware_angle_export_canvas(uint32_t alpha) {
+    auto* context=gl::GetValidGlobalContext();
+    if (!context || !firmware_angle_prepare_context(context)) return 0;
+    auto* framebuffer=context->getState().getReadFramebuffer();
+    return framebuffer ? rx::vk::GetImpl(framebuffer)->firmwareExportCanvas(rx::vk::GetImpl(context),alpha) : 0;
+}
