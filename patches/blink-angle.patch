+
+#if defined(UEFI_RUNTIME)
+extern "C" uint64_t firmware_gpu_copy_canvas(VkInstance,VkPhysicalDevice,VkDevice,VkQueue,uint32_t,VkImage,VkImageLayout,uint32_t,uint32_t,VkFormat,uint32_t);
+uint64_t rx::FramebufferVk::firmwareExportCanvas(ContextVk *context,uint32_t alpha) {
+    if (flushDeferredClears(context)!=angle::Result::Continue ||
+        context->finishImpl(rx::QueueSubmitReason::GLFinish)!=angle::Result::Continue) return 0;
+    auto* target=getColorReadRenderTarget();
+    if (!target) return 0;
+    auto& image=target->getImageForCopy();
+    auto* renderer=context->getRenderer();
+    const auto extent=image.getExtents();
+    if (image.getVkImageCreateInfo().samples!=VK_SAMPLE_COUNT_1_BIT) return 0;
+    uint32_t flags=alpha | (context->isViewportFlipEnabledForReadFBO() ? 0 : 2);
+    return firmware_gpu_copy_canvas(renderer->getInstance(),renderer->getPhysicalDevice(),renderer->getDevice(),
+        renderer->getQueue(context->getPriority()),renderer->getQueueFamilyIndex(),image.getImage().getHandle(),
+        image.getCurrentLayout(renderer),extent.width,extent.height,image.getActualVkFormat(renderer),flags);
+}
+#endif
