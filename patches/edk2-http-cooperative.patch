diff --git a/NetworkPkg/HttpDxe/HttpDriver.h b/NetworkPkg/HttpDxe/HttpDriver.h
index 21d0f33..af34464 100644
--- a/NetworkPkg/HttpDxe/HttpDriver.h
+++ b/NetworkPkg/HttpDxe/HttpDriver.h
@@ -399,3 +399,18 @@ HttpServiceBindingDestroyChild (
   IN EFI_SERVICE_BINDING_PROTOCOL  *This,
   IN EFI_HANDLE                    ChildHandle
   );
+
+#ifndef UEFI_BROWSER_COOPERATIVE_H
+#define UEFI_BROWSER_COOPERATIVE_H
+STATIC EFI_GUID __attribute__((unused)) mBrowserHttpBinding = {0xc1493c30,0x94c5,0x49b3,{0x94,0xe4,0xac,0xb5,0x02,0x39,0x11,0x81}};
+STATIC inline VOID BrowserYield (VOID) {
+  EFI_GUID Identifier = {0x38bed393,0x2ced,0x41da,{0x8d,0x01,0x78,0x72,0xbc,0x62,0xde,0x24}};
+  typedef struct { VOID (EFIAPI *Yield)(VOID); } YIELD_PROTOCOL;
+  YIELD_PROTOCOL *Protocol;
+  EFI_TPL Previous = gBS->RaiseTPL (TPL_HIGH_LEVEL);
+  gBS->RestoreTPL (Previous);
+  // Suspending firmware at elevated TPL would prevent the renderer from making progress.
+  if (Previous != TPL_APPLICATION) return;
+  if (!EFI_ERROR (gBS->LocateProtocol (&Identifier, NULL, (VOID **)&Protocol))) Protocol->Yield ();
+}
+#endif
