diff --git a/src/dawn/native/vulkan/TextureVk.cpp b/src/dawn/native/vulkan/TextureVk.cpp
index 0686ef93e..a4584f0b2 100644
--- a/src/dawn/native/vulkan/TextureVk.cpp
+++ b/src/dawn/native/vulkan/TextureVk.cpp
@@ -2304,3 +2304,30 @@ void TextureView::SetLabelImpl() {
 }
 
 }  // namespace dawn::native::vulkan
+
+#if defined(UEFI_RUNTIME)
+extern "C" uint64_t firmware_gpu_copy_canvas(VkInstance,VkPhysicalDevice,VkDevice,VkQueue,uint32_t,VkImage,VkImageLayout,uint32_t,uint32_t,VkFormat,uint32_t);
+extern "C" uint64_t firmware_dawn_export_canvas(WGPUTexture handle,uint32_t alpha) {
+    using namespace dawn::native;
+    using namespace dawn::native::vulkan;
+    auto* base=reinterpret_cast<TextureBase*>(handle);
+    if (!base || base->IsError() || base->IsDestroyed()) return 0;
+    auto* texture=ToBackend(base);
+    auto* device=ToBackend(texture->GetDevice());
+    auto* queue=ToBackend(device->GetQueue());
+    auto* recording=queue->GetPendingRecordingContext();
+    auto range=texture->GetAllSubresources();
+    auto initialized=texture->EnsureSubresourceContentInitialized(recording,range);
+    if (initialized.IsError()) { initialized.AcquireError(); return 0; }
+    texture->TransitionUsageNow(recording,wgpu::TextureUsage::CopySrc,wgpu::ShaderStage::None,range);
+    auto submitted=queue->SubmitPendingCommands();
+    if (submitted.IsError()) { submitted.AcquireError(); return 0; }
+    auto size=texture->GetSize(Aspect::Color);
+    auto format=texture->GetFormat().format==wgpu::TextureFormat::BGRA8Unorm ? VK_FORMAT_B8G8R8A8_UNORM :
+        texture->GetFormat().format==wgpu::TextureFormat::RGBA8Unorm ? VK_FORMAT_R8G8B8A8_UNORM :
+        texture->GetFormat().format==wgpu::TextureFormat::RGBA16Float ? VK_FORMAT_R16G16B16A16_SFLOAT : VK_FORMAT_UNDEFINED;
+    return firmware_gpu_copy_canvas(device->GetVkInstance(),ToBackend(device->GetPhysicalDevice())->GetVkPhysicalDevice(),
+        device->GetVkDevice(),queue->GetVkQueue(),device->GetGraphicsQueueFamily(),texture->GetHandle(),
+        texture->GetCurrentLayout(Aspect::Color),size.width,size.height,format,alpha);
+}
+#endif
